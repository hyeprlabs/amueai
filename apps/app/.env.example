# AmueAI — Supabase (project: AmueAI, vwacvviffixddrxbxnkc)
# Clerk is configured as a third-party auth provider in this project's
# Authentication settings, and Clerk's Supabase integration points back
# at it, so auth.jwt()->>'org_id' resolves for RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The new Supabase secret key (sb_secret_...), not the legacy service_role JWT.
SUPABASE_SECRET_KEY=

# AmueAI — Vercel AI Gateway (never call a provider SDK directly)
AI_GATEWAY_API_KEY=

# AmueAI — Firecrawl (all URL and file-upload source ingestion goes
# through this, never a hand-rolled fetch/cheerio crawler or PDF/Office
# parsing library - see lib/ingestion.ts)
FIRECRAWL_API_KEY=

# AmueAI — Trigger.dev (background ingestion - see src/trigger/ingest-source.ts
# and trigger.config.ts, whose "project" field needs the real proj_... ref
# from the Trigger.dev dashboard before `npx trigger.dev@latest dev|deploy`
# will run)
TRIGGER_SECRET_KEY=

# AmueAI — rate limiting (public chat route only)
# Redis.fromEnv() in lib/rate-limit.ts reads UPSTASH_REDIS_REST_URL/TOKEN
# first, falling back to KV_REST_API_URL/TOKEN (the Vercel Marketplace
# Upstash integration's naming) - only one pair is needed.
KV_REST_API_URL=
KV_REST_API_TOKEN=
