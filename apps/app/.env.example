# AmueAI — Supabase (project: AmueAI, vwacvviffixddrxbxnkc)
# Clerk is configured as a third-party auth provider in this project's
# Authentication settings, and Clerk's Supabase integration points back
# at it, so auth.jwt()->>'org_id' resolves for RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The new Supabase secret key (sb_secret_...), not the legacy service_role JWT.
SUPABASE_SECRET_KEY=

# AmueAI — Vercel AI Gateway (never call a provider SDK directly)
AI_GATEWAY_API_KEY=

# AmueAI — Phase 10 (background ingestion + rate limiting)
# Trigger.dev project: proj_bhfgpttdkwfmnqrkslup (see trigger.config.ts)
TRIGGER_SECRET_KEY=
# Redis.fromEnv() in lib/rate-limit.ts reads UPSTASH_REDIS_REST_URL/TOKEN
# first, falling back to KV_REST_API_URL/TOKEN (the Vercel Marketplace
# Upstash integration's naming) - only one pair is needed.
KV_REST_API_URL=
KV_REST_API_TOKEN=
