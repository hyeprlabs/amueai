# Created by Vercel CLI
BLOB_READ_WRITE_TOKEN=
CLERK_SECRET_KEY=
DATABASE_URL=
FLAGS=
FLAGS_SECRET=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
NEXT_PUBLIC_SITE_URL=
PAYLOAD_PREVIEW_SECRET=
PAYLOAD_SECRET=
VERCEL_OIDC_TOKEN=

# AmueAI — Supabase (project: AmueAI, vwacvviffixddrxbxnkc)
# Clerk is configured as a third-party auth provider in this project's
# Authentication settings, and Clerk's Supabase integration points back
# at it, so auth.jwt()->>'org_id' resolves for RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The new Supabase secret key (sb_secret_...), not the legacy service_role JWT.
SUPABASE_SECRET_KEY=

# AmueAI — Vercel AI Gateway (never call a provider SDK directly)
AI_GATEWAY_API_KEY=

# AmueAI — Firecrawl (every source type normalizes to markdown through
# this: .scrape()/.crawl() for url, .parse() for file - never a hand-rolled
# fetch/cheerio crawler or PDF/Office parsing library - see lib/firecrawl.ts,
# src/trigger/ingest-source.ts, src/trigger/crawl-website.ts)
FIRECRAWL_API_KEY=

# AmueAI — Trigger.dev (background ingestion - see src/trigger/*.ts
# and trigger.config.ts, whose "project" field needs the real proj_... ref
# from the Trigger.dev dashboard before `npx trigger.dev@latest dev|deploy`
# will run). Vars here are for THIS app (Vercel/local) triggering tasks -
# the Trigger.dev project itself needs its own copies of
# NEXT_PUBLIC_SUPABASE_URL/SUPABASE_SECRET_KEY/FIRECRAWL_API_KEY/
# AI_GATEWAY_API_KEY set on its own dashboard (or via its envvars API),
# since tasks run on Trigger.dev's infrastructure, not Vercel's.
TRIGGER_SECRET_KEY=

# AmueAI — Storage backend for original uploads and every source's
# canonical extracted markdown, via files-sdk (lib/storage.ts) - the one
# file that knows which backend is active. Currently Supabase only (uses
# NEXT_PUBLIC_SUPABASE_URL/SUPABASE_SECRET_KEY above, bucket "sources") -
# see lib/storage.ts's own comment for what installing the R2 adapter
# later requires (its AWS SDK peer deps aren't installed today, and
# Trigger.dev's bundler needs them resolvable even for an unused branch).

# AmueAI — weekly recrawl cron (vercel.json -> /api/cron/recrawl-sources).
# Vercel auto-provisions this for cron routes; nothing to set by hand once
# the project is deployed there.
CRON_SECRET=

# AmueAI — rate limiting (public chat route only)
# Redis.fromEnv() in lib/rate-limit.ts reads UPSTASH_REDIS_REST_URL/TOKEN
# first, falling back to KV_REST_API_URL/TOKEN (the Vercel Marketplace
# Upstash integration's naming) - only one pair is needed.
KV_REST_API_URL=
KV_REST_API_TOKEN=
